#!name=云润水费查询配置抓取
#!desc=在微信中打开水费账单或缴费页面，自动抓取 appId、openId、customerId、Cookie 和 UA 并写入 BoxJS，供 Scripting 小组件实时查询。
#!category=Utility

[Rule]
DOMAIN,wx.chinayunrun.com,DIRECT

[Script]
water-bill-capture = type=http-request, pattern=^https?://wx\.chinayunrun\.com(?::80)?/wechat/(?:billCharge|billMsg/findBillList)(?:\?|$), requires-body=1, timeout=10, script-path=https://raw.githubusercontent.com/yourswoo/surge-module/refs/heads/waterbill/water-bill.js

[MITM]
hostname = %APPEND% wx.chinayunrun.com
