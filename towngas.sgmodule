#!name=港华燃气账户查询
#!desc=自动抓取港华主业务 Bearer 和账户 ID，动态生成查询签名；oauth 接力每 80 分钟自动续签 token，失败 10 分钟即重试，无需重复打开小程序；定时 cron 仅负责推送账户通知。
#!category=Utility
#!arguments=panel_refresh:900,session_refresh:80,cronexp:0 9 * * *
#!arguments-desc=panel_refresh: Surge 面板刷新间隔（秒），默认 900；填 -1 关闭面板自动刷新。\nsession_refresh: Cookie 静默续期间隔（分钟），默认 80；填 0 关闭。\ncronexp: 账户通知时间，默认每天 09:00；只有此任务会发送 Surge 通知，修改后需重新加载模块。

[Rule]
DOMAIN,weixin.towngasvcc.com,DIRECT

[Panel]
towngas-account-panel = script-name=towngas-account-panel, update-interval={{{panel_refresh}}}

[Script]
# Surge 面板：读取 BoxJS 中已抓取的配置，实时查询余额、表数和阶梯用量。
towngas-account-panel = type=generic, timeout=25, script-path=https://raw.githubusercontent.com/yourswoo/surge-module/refs/heads/gasbill/towngas.js, argument=mode=panel

# 会话续期：调度器每 10 分钟检查一次，距上次实际查询满 session_refresh 分钟才请求；成功、失败均不通知。
towngas-account-refresh = type=cron, cronexp="*/10 * * * *", timeout=30, wake-system=1, script-path=https://raw.githubusercontent.com/yourswoo/surge-module/refs/heads/gasbill/towngas.js, argument=mode=refresh&minutes={{{session_refresh}}}

# token 接力：每 10 分钟检查，距上次成功接力满 80 分钟用 refresh_token 换全新 token（滚动签发）；失败下个周期即重试，链断时提醒重新打开小程序（点火后 10 分钟内自动接回）。
towngas-token-refresh = type=cron, cronexp="*/10 * * * *", timeout=30, wake-system=1, script-path=https://raw.githubusercontent.com/yourswoo/surge-module/refs/heads/gasbill/towngas.js, argument=mode=token-refresh

# 账户通知：默认每天 09:00 查询一次，并将余额、待缴、表数、阶梯和最近账单推送到 Surge。
towngas-account-cron = type=cron, cronexp="{{{cronexp}}}", timeout=30, wake-system=1, script-path=https://raw.githubusercontent.com/yourswoo/surge-module/refs/heads/gasbill/towngas.js, argument=mode=cron

# 打开港华页面即可从 getLoginUserInfo / queryBindList 更新主业务 Bearer；进入充值购气页补齐 subsId / orgId。
towngas-account-capture = type=http-request, pattern=^https://weixin\.towngasvcc\.com/nv1/vcc-cbs/(?:usersubs/(?:getLoginUserInfo|queryBindList)|charge/(?:preCheck|gasStepFee|queryHistoryFee))(?:\?|$), requires-body=0, timeout=10, script-path=https://raw.githubusercontent.com/yourswoo/surge-module/refs/heads/gasbill/towngas.js, argument=mode=capture

# 登录瞬间自动换新 Bearer 并启动接力链：微信端 accessToekn 与支付宝端 union 响应都返回 access_token + refresh_token，抓取后写入 BoxJS。
towngas-oauth-capture = type=http-response, pattern=^https://weixin\.towngasvcc\.com/vcc-oauth/oauth/authorize2/(?:accessToekn|union)(?:\?|$), requires-body=1, timeout=10, script-path=https://raw.githubusercontent.com/yourswoo/surge-module/refs/heads/gasbill/towngas.js, argument=mode=capture-oauth

[MITM]
hostname = %APPEND% weixin.towngasvcc.com
