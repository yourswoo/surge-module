{
  "id": "towngas.account",
  "name": "港华燃气",
  "author": "Yong",
  "icon": "https://raw.githubusercontent.com/yourswoo/surge-module/refs/heads/gasbill/towngas.png",
  "apps": [
    {
      "id": "towngas_account",
      "name": "燃气余额与账单",
      "keys": [
        "towngas_authorization",
        "towngas_cookie",
        "towngas_ua",
        "towngas_referer",
        "towngas_subs_id",
        "towngas_org_id",
        "towngas_precheck_url",
        "towngas_step_url",
        "towngas_history_url",
        "towngas_label",
        "towngas_title",
        "towngas_balance_threshold",
        "towngas_balance_critical_threshold",
        "towngas_refresh_minutes",
        "towngas_capnotify",
        "towngas_captured_at",
        "towngas_debug"
      ],
      "settings": [
        {
          "id": "towngas_label",
          "name": "账户标签",
          "val": "我家燃气",
          "type": "text",
          "desc": "例如：我家燃气"
        },
        {
          "id": "towngas_title",
          "name": "小组件标题",
          "val": "港华燃气",
          "type": "text"
        },
        {
          "id": "towngas_balance_threshold",
          "name": "余额偏低阈值",
          "val": "100",
          "type": "text",
          "desc": "单位：元；低于此金额显示橙色"
        },
        {
          "id": "towngas_balance_critical_threshold",
          "name": "余额不足阈值",
          "val": "50",
          "type": "text",
          "desc": "单位：元；达到或低于此金额显示红色"
        },
        {
          "id": "towngas_refresh_minutes",
          "name": "小组件刷新间隔",
          "val": "30",
          "type": "text",
          "desc": "单位：分钟；iOS 可能根据系统调度延后刷新"
        },
        {
          "id": "towngas_capnotify",
          "name": "抓取成功通知",
          "val": "1",
          "type": "text",
          "desc": "1 开启，0 关闭"
        },
        {
          "id": "towngas_authorization",
          "name": "Bearer 凭证",
          "val": "",
          "type": "textarea",
          "rows": 3,
          "desc": "由 Surge 自动抓取，请勿对外分享"
        },
        {
          "id": "towngas_cookie",
          "name": "Cookie",
          "val": "",
          "type": "textarea",
          "rows": 4,
          "desc": "由 Surge 自动抓取"
        },
        {
          "id": "towngas_ua",
          "name": "微信 User-Agent",
          "val": "",
          "type": "textarea",
          "rows": 4,
          "desc": "由 Surge 自动抓取"
        },
        {
          "id": "towngas_referer",
          "name": "Referer",
          "val": "",
          "type": "textarea",
          "rows": 3,
          "desc": "由 Surge 自动抓取"
        },
        {
          "id": "towngas_subs_id",
          "name": "户号内部 ID",
          "val": "",
          "type": "textarea",
          "rows": 2,
          "desc": "由 Surge 自动抓取"
        },
        {
          "id": "towngas_org_id",
          "name": "燃气公司 ID",
          "val": "",
          "type": "textarea",
          "rows": 2,
          "desc": "由 Surge 自动抓取"
        },
        {
          "id": "towngas_precheck_url",
          "name": "账户概览签名 URL",
          "val": "",
          "type": "textarea",
          "rows": 4,
          "desc": "包含 preCheck 的 timestamp 和 sign，由 Surge 自动更新"
        },
        {
          "id": "towngas_step_url",
          "name": "阶梯气价签名 URL",
          "val": "",
          "type": "textarea",
          "rows": 4,
          "desc": "包含 gasStepFee 的 timestamp 和 sign，由 Surge 自动更新"
        },
        {
          "id": "towngas_history_url",
          "name": "历史账单签名 URL",
          "val": "",
          "type": "textarea",
          "rows": 4,
          "desc": "包含 queryHistoryFee 的 timestamp 和 sign，打开历史账单页后自动更新"
        },
        {
          "id": "towngas_captured_at",
          "name": "最后抓取时间",
          "val": "",
          "type": "text",
          "desc": "由 Surge 自动更新"
        },
        {
          "id": "towngas_debug",
          "name": "调试日志",
          "val": "0",
          "type": "text",
          "desc": "1 开启，0 关闭"
        }
      ]
    }
  ]
}
